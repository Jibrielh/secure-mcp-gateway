# Copy to .env and replace every change-me value.
# .env is ignored. Do not commit generated secrets.
# No paid API key is required.

# memory is single-process and loses state on exit.
# postgres is required for the durable workspace.
AGENTGATE_STORE=postgres
DATABASE_URL=postgres://agentgate:change-me@127.0.0.1:5432/agentgate?sslmode=disable

# memory keeps the historical gateway CLI behavior.
# The workspace and Compose profiles set redis and fail closed if it is down.
AGENTGATE_LIMITER=redis
REDIS_URL=redis://127.0.0.1:6379/0

# Shared by the workspace and the gateway. At least 32 characters.
GATEWAY_INTERNAL_SECRET=change-me-internal-secret-32-characters

# Legacy MCP bearer tokens. Required by cmd/gateway. Not sent to the browser.
GATEWAY_VIEWER_TOKEN=change-me-viewer-token-32-characters
GATEWAY_DEVELOPER_TOKEN=change-me-developer-token-32-characters
GATEWAY_ADMIN_TOKEN=change-me-admin-token-32-characters
GATEWAY_APPROVER_TOKEN=change-me-approver-token-32-characters

# Development password login. Keep 0 unless you are running the local demo.
AGENTGATE_DEV_LOGIN=0
AGENTGATE_DEV_PASSWORD=change-me-dev-only

# OIDC. Leave blank to use development login only when that login is enabled.
OIDC_ISSUER=http://127.0.0.1:8081/realms/agentgate
OIDC_CLIENT_ID=agentgate-workspace
OIDC_CLIENT_SECRET=change-me-oidc-client-secret
OIDC_REDIRECT_URL=http://127.0.0.1:8090/api/v1/auth/callback
OIDC_AUDIENCE=agentgate-workspace

# Loopback Ollama. The workspace rejects any other host.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional read-only GitHub token for higher public API quota.
# The process receives it only for the GitHub connector.
GITHUB_TOKEN=

# Sample analytics database. sqlite is the default local file.
SAMPLE_DATABASE_URL=file:fixtures/sample.db?mode=rwc
# Postgres alternative with a SELECT-only role:
# SAMPLE_DATABASE_URL=postgres://sample_reader:change-me@127.0.0.1:5432/agentgate_sample?sslmode=disable

AGENTGATE_PUBLIC_URL=http://127.0.0.1:8090
AGENTGATE_GATEWAY_URL=http://127.0.0.1:8080/mcp
AGENTGATE_FILES_ROOT=fixtures/workspace
